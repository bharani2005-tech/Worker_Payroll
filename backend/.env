# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:4200

# MongoDB
# Local dev example - replace with your own MongoDB Atlas connection string for production
MONGO_URI=mongodb+srv://workerpro:bharani@cluster0bha.mqhf8nx.mongodb.net/workerpay?appName=Cluster0bha

# JWT
JWT_ACCESS_SECRET=replace_with_a_long_random_secret_for_access_tokens
JWT_REFRESH_SECRET=replace_with_a_long_random_secret_for_refresh_tokens
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Account lockout
MAX_LOGIN_ATTEMPTS=5
LOCK_TIME_MINUTES=15

# Email (for OTP password reset) - use an app password, never your real account password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="WorkerPay Pro <no-reply@workerpay.com>"

# Cloudinary (avatar uploads) - optional
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=